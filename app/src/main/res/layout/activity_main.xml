<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩺 Lung Stethoscope AI"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ESP32-S3 Live Stream • Neural Noise Removal • Pure Lung Sound"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- CARD 1: ESP32 Wi-Fi Stream & Live Monitor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. ESP32-S3 WI-FI STREAM"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <EditText
                android:id="@+id/etStreamUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#243247"
                android:hint="http://192.168.4.1/stream"
                android:text="http://192.168.4.1/stream"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_dim"
                android:textSize="13sp"
                android:padding="10dp"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Status: Disconnected"
                    android:textColor="@color/accent_red"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/accent_blue"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- VU Level Meter -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Live Microphone Signal Level:"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/pbAudioLevel"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/primary" />

            <!-- Live Speaker Toggle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleSpeaker"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🔊 Live Earphone/Speaker: ON"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                app:strokeColor="@color/card_stroke"
                app:cornerRadius="8dp" />

            <!-- Record Button & Timer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="● Start Recording"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_red"
                    app:cornerRadius="8dp" />

                <TextView
                    android:id="@+id/tvRecordTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="00:00"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 2: HEAR RECORDED AUDIO (Play Clean Sound) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. 🔊 HEAR RECORDED LUNG SOUND"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvLatestRecordingInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No recording yet. Hit 'Start Recording' above!"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- Primary Play Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHearClean"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="▶ HEAR CLEAN LUNG SOUND"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="10dp" />

            <!-- Playback SeekBar -->
            <SeekBar
                android:id="@+id/sbPlayback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary" />

            <TextView
                android:id="@+id/tvPlaybackTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00:00 / 00:00"
                android:textAlignment="center"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <!-- Secondary Controls: Pause & Stop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPause"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="⏸ Pause"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    app:strokeColor="@color/card_stroke"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopAudio"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⏹ Stop"
                    android:textAllCaps="false"
                    android:textColor="@color/text_muted"
                    app:strokeColor="@color/card_stroke"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 3: SAVE & EXPORT OPTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. 💾 SAVE &amp; EXPORT OPTIONS"
                android:textColor="@color/accent_orange"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvSaveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Save clean audio to phone storage or share it directly:"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <!-- Save to Phone Storage Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveToDevice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="💾 Save to Phone"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_orange"
                    app:cornerRadius="8dp" />

                <!-- Share Audio File Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareAudio"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📤 Share / Export"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    app:strokeColor="@color/accent_blue"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 4: SAVED RECORDINGS HISTORY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. SAVED RECORDINGS HISTORY"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <Spinner
                android:id="@+id/spRecordings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="#243247"
                android:spinnerMode="dropdown" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayHistory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="▶ Play Selected"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/accent_blue"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🗑 Delete"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_red"
                    app:strokeColor="@color/card_stroke"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
